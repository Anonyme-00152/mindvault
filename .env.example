# ─── Auth (server-only, never shipped to the browser) ────────────────────────
# Credentials used by /api/auth/login. Change them before deploying.
AUTH_USER=demo
AUTH_PASSWORD=vault-2026

# Random string used to sign the session cookie (HMAC-SHA256). 32+ chars.
SESSION_SECRET=change-me-to-a-long-random-string-please-0123456789

# ─── AI (server-only) ────────────────────────────────────────────────────────
# Optional. Without it the assistant runs in "demo mode" with a local heuristic
# so the product still works end-to-end. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ─── Public ──────────────────────────────────────────────────────────────────
# Shown on the login screen so visitors can try the demo. Set to "false" in prod.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Push notifications (iPhone / Android / desktop) ────────────────────────
# Generate a key pair once:  npm run push:keys
# The public key is sent to the browser; the private key never leaves the server.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/push/tick (the scheduler). Vercel Cron sends it as a Bearer token.
CRON_SECRET=change-me-cron-secret

# Where subscriptions + pending reminders are stored.
#  - default: a JSON file (fine for self-hosting / local); on Vercel it falls back to /tmp (ephemeral)
#  - Upstash Redis (free tier) for durable storage on Vercel: set both vars.
#PUSH_STORE_FILE=.data/push.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=